APP_NAME="Cuticul Dental Clinic"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_TIMEZONE=Asia/Ulaanbaatar
APP_URL=https://yourdomain.mn

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=cuticul_db
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_USERNAME=your@gmail.com
MAIL_PASSWORD=your_app_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@yourdomain.mn"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# ── QPay Төлбөрийн систем ─────────────────────────────────────────────────────
QPAY_BASE_URL=https://merchant.qpay.mn/v2
QPAY_USERNAME=YOUR_MERCHANT_USERNAME
QPAY_PASSWORD=YOUR_MERCHANT_PASSWORD
QPAY_INVOICE_CODE=YOUR_INVOICE_CODE
QPAY_TEST_MODE=false

# ── Google Meet (OAuth 2.0) ───────────────────────────────────────────────────
# Google Cloud Console > APIs > Credentials > OAuth 2.0 Client IDs
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret
GOOGLE_REDIRECT_URI="${APP_URL}/google/callback"
# Refresh token: Admin панелд /google/redirect хуудсаар нэг удаа авна
GOOGLE_REFRESH_TOKEN=

# ── Meta Social Bot (Facebook Page + Instagram) ───────────────────────────────
# developers.facebook.com > App settings > Basic
META_APP_ID=
META_APP_SECRET=
# Webhook баталгаажуулах өөрийн зохиосон нууц мөр (ж: dental_secret_2026)
META_VERIFY_TOKEN=
META_API_VERSION=v21.0
META_GRAPH_URL=https://graph.facebook.com

# ── AI чат (ботын ухаалаг fallback) ──────────────────────────────────────────
# Google Gemini — aistudio.google.com > Get API key (чанар сайн, үнэгүй хязгаар бага)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
# Groq — console.groq.com (үнэгүй, өгөөмөр хязгаар, картгүй). AI туслах хуудаснаас сонгоно.
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile

# ── CallPro дуудлагын интеграц ───────────────────────────────────────────────
# Нууц түлхүүрийг БИД үүсгээд CallPro-д өгнө. Тэд хүсэлт бүрт
# X-Callpro-Token header-ээр буцааж илгээнэ. Шинээр үүсгэх:
#   php -r "echo bin2hex(random_bytes(24));"
CALLPRO_WEBHOOK_TOKEN=
# CallPro-гийн мэдэгдсэн сервер (2026-09-04). Таслалаар тусгаарлана.
CALLPRO_ALLOWED_IPS=202.37.235.42,112.72.0.69,112.72.0.138

# Cloudflare / load balancer / урд талын nginx-ийн АРД ажиллаж байвал ЗААВАЛ
# тохируулна — эс бөгөөс дээрх IP шүүлтүүр proxy-ийн хаягтай тулгалдаж бүх
# CallPro webhook 403 болж хаагдана.
#   (хоосон) — proxy байхгүй, шууд PHP-FPM руу ордог
#   *        — хүсэлт дамжуулж буй proxy-д итгэнэ (Cloudflare/LB-ийн ард)
TRUSTED_PROXIES=

# LibreOffice — PPT/DOCX хичээлийг PDF болгож хөрвүүлэхэд (заавал биш).
# Суулгаагүй бол зөвхөн PDF хичээл байршуулна.
# Windows дээр ГАНЦ хашилт хэрэглэнэ — давхар хашилт дотор \ нь escape гэж
# уншигдаж, dotenv "unexpected escape sequence" алдаа өгнө.
# Windows: LIBREOFFICE_PATH='C:\Program Files\LibreOffice\program\soffice.exe'
LIBREOFFICE_PATH=
LIBREOFFICE_TIMEOUT=180

# Сургалтын видеоны диск (default: lab_video → storage/app/private/lab-videos)
# R2/S3 руу шилжихэд: LAB_VIDEO_DISK=s3 болгоод AWS_* утгуудаа бөглөнө.
LAB_VIDEO_DISK=lab_video

# Баримт хичээлийн диск (default: lab_doc → storage/app/private/lab-docs)
LAB_DOC_DISK=lab_doc
